rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────
    function autenticado() {
      return request.auth != null;
    }
    function perfilExiste() {
      return autenticado()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function perfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Conta desativada não escreve nada. Antes isso era só checado na interface
    // (app.js faz signOut ao ver active:false), o que um cliente modificado ignora.
    function contaAtiva() {
      return perfilExiste() && perfil().get('active', true) != false;
    }
    function papel() {
      return perfilExiste() ? perfil().get('role', 'leitor') : 'leitor';
    }
    function ehAdmin() {
      return contaAtiva() && papel() == 'admin';
    }
    function podeEscreverDados() {
      return contaAtiva() && (papel() == 'admin' || papel() == 'editor');
    }

    // ── Dados do sistema ───────────────────────────────────────────────────────
    match /teds/{tedId} {
      allow read: if autenticado();
      allow write: if podeEscreverDados();
    }

    match /planosTrabalho/{planoId} {
      allow read: if autenticado();
      allow write: if podeEscreverDados();
    }

    // Marcador de última gravação, para sincronização em tempo real entre aparelhos
    match /sync/{docId} {
      allow read: if autenticado();
      allow write: if podeEscreverDados();
    }

    // Meta (controle de IDs sequenciais)
    match /meta/{docId} {
      allow read: if autenticado();
      allow write: if podeEscreverDados();
    }

    // ── Usuários ───────────────────────────────────────────────────────────────
    // ATENÇÃO: a regra anterior permitia `request.auth.uid == userId` para QUALQUER
    // escrita no próprio documento — ou seja, um usuário 'leitor' podia se promover a
    // 'admin' (ou um editor remover a própria restrição de UP) escrevendo o próprio
    // perfil pelo console do navegador. Campos de privilégio agora só mudam por admin.
    match /users/{userId} {
      allow read: if autenticado();

      // Auto-provisionamento no primeiro login só pode criar conta SEM privilégio.
      allow create: if ehAdmin()
                    || (autenticado()
                        && request.auth.uid == userId
                        && request.resource.data.get('role', 'leitor') == 'leitor');

      // O próprio usuário pode ajustar dados não-privilegiados (ex.: displayName),
      // desde que role / active / upRestrita permaneçam exatamente como estão.
      allow update: if ehAdmin()
                    || (autenticado()
                        && request.auth.uid == userId
                        && request.resource.data.get('role', 'leitor') == resource.data.get('role', 'leitor')
                        && request.resource.data.get('active', true) == resource.data.get('active', true)
                        && request.resource.data.get('upRestrita', null) == resource.data.get('upRestrita', null));

      allow delete: if ehAdmin();
    }

    // ── Auditoria ──────────────────────────────────────────────────────────────
    // Imutável por design: só criação, nunca alteração/remoção.
    match /auditLog/{logId} {
      allow create: if podeEscreverDados();
      allow read: if ehAdmin();
      allow update, delete: if false;
    }

    // Negar explicitamente qualquer coleção não prevista acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
